# Stokita — contoh environment variable.
# Salin ke `.env.local` (development) lalu isi nilainya dari dashboard Supabase
# (Settings → API). Jangan pernah commit file berisi nilai rahasia:
# .env.local sudah masuk .gitignore.

# ---------------------------------------------------------------------------
# Development & Production — Wajib (klien Supabase)
# ---------------------------------------------------------------------------
# Aman untuk browser karena diawali NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Development & Production — Server saja
# ---------------------------------------------------------------------------
# HANYA untuk proses server/administrasi (pembuatan akun: npm run seed:accounts).
# Jangan pernah diawali NEXT_PUBLIC_ dan jangan pernah dikirim ke browser.
# Di Vercel: isi melalui dashboard (Settings → Environment Variables),
# bukan melalui source code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Seed akun awal — HANYA untuk `npm run seed:accounts` (opsional)
# ---------------------------------------------------------------------------
# Password akun awal dibaca dari environment (bukan dari source/SQL).
# Isi hanya di .env.local lokal Anda atau di sesi shell yang aman.
# Jangan pernah menyimpan nilai ini di repository.
# STOKITA_ADMIN_PASSWORD=
# STOKITA_KASIR1_PASSWORD=
# STOKITA_KASIR2_PASSWORD=
